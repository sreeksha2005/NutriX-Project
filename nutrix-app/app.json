{
  "expo": {
    "name": "NutriX",
    "slug": "nutrix-app",
    "version": "1.0.0",
    "scheme": "nutrix",
    "orientation": "portrait",
    "icon": "./assets/nutrix-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101418",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/nutrix-icon.png"
    },
    "android": {
      "icon": "./assets/nutrix-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/nutrix-icon-adaptive.png",
        "backgroundColor": "#F9F1E6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nutrix.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/nutrix-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#101418"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriX needs access to your photos to analyze food images.",
          "cameraPermission": "NutriX needs access to your camera to analyze food images."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://192.168.1.46:8000"
    }
  }
}
