{
  "expo": {
    "name": "NutriX",
    "slug": "nutrix-app",
    "version": "1.0.0",
    "scheme": "nutrix",
    "orientation": "portrait",
    "icon": "./assets/nutrix-logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101418",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/nutrix-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#101418"
    },
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/nutrix-logo.png", "backgroundColor": "#101418" },
      "edgeToEdgeEnabled": true
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriX needs access to your photos to analyze food images.",
          "cameraPermission": "NutriX needs access to your camera to analyze food images."
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "apiBaseUrl": "http://192.168.1.10:5000"
    }
  }
}
